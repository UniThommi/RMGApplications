	<materials>
		<element name="Hydrogen" formula="H" Z="1">
			<atom value="1.00794"/>
		</element>
		<material name="vacuum">
			<property name="RINDEX" ref="vacuum_RINDEX"/>
			<D value="1e-25"/>
			<composite ref="Hydrogen" n="1"/>
		</material>
		<element name="Carbon" formula="C" Z="6">
			<atom value="12.011"/>
		</element>
		<material name="my_tyvek">
			<D value="0.38"/>
			<composite ref="Carbon" n="2"/>
			<composite ref="Hydrogen" n="4"/>
		</material>
		<element name="Silicon" formula="Si" Z="14">
			<atom value="28.09"/>
		</element>
		<element name="Chromium" formula="Cr" Z="24">
			<atom value="51.9961"/>
		</element>
		<element name="Manganese" formula="Mn" Z="25">
			<atom value="54.93805"/>
		</element>
		<element name="Iron" formula="Fe" Z="26">
			<atom value="55.845"/>
		</element>
		<element name="Nickel" formula="Ni" Z="28">
			<atom value="58.6934"/>
		</element>
		<material name="metal_steel">
			<D value="7.9"/>
			<fraction ref="Silicon" n="0.01"/>
			<fraction ref="Chromium" n="0.2"/>
			<fraction ref="Manganese" n="0.02"/>
			<fraction ref="Iron" n="0.67"/>
			<fraction ref="Nickel" n="0.1"/>
		</material>
	</materials>
	<solids>
		<box name="world" x="10000" y="10000" z="10000" lunit="mm"/>
		<sphere name="my_tyvek_sphere_solid" rmin="1739.52" rmax="1740.52" deltaphi="6.283185307179586" startphi="0.0" starttheta="0.0" deltatheta="3.141592653589793" lunit="mm" aunit="rad"/>
		<opticalsurface name="my_tyvek_foil_surface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="0.3">
			<property name="EFFICIENCY" ref="my_tyvek_foil_surface_EFFICIENCY"/>
			<property name="REFLECTIVITY" ref="my_tyvek_foil_surface_REFLECTIVITY"/>
		</opticalsurface>
		<sphere name="inner_sphere" rmin="0" rmax="1000" deltaphi="6.283185307179586" startphi="0.0" starttheta="0.0" deltatheta="3.141592653589793" lunit="mm" aunit="rad"/>
		<opticalsurface name="tyvek_foil_surface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="0.3">
			<property name="EFFICIENCY" ref="tyvek_foil_surface_EFFICIENCY"/>
			<property name="REFLECTIVITY" ref="tyvek_foil_surface_REFLECTIVITY"/>
		</opticalsurface>
	</solids>
	<structure>
		<volume name="my_tyvek_sphere_log">
			<materialref ref="my_tyvek"/>
			<solidref ref="my_tyvek_sphere_solid"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,1,1,0.2"/>
		</volume>
		<volume name="inner_sphere_log">
			<materialref ref="metal_steel"/>
			<solidref ref="inner_sphere"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,0,1,0.2"/>
		</volume>
		<volume name="world">
			<materialref ref="vacuum"/>
			<solidref ref="world"/>
			<physvol name="TyvekSphere_phys">
				<volumeref ref="my_tyvek_sphere_log"/>
			</physvol>
			<physvol name="InnerSphere_phys">
				<volumeref ref="inner_sphere_log"/>
			</physvol>
		</volume>
		<skinsurface name="my_tyvek_sphere_surface" surfaceproperty="my_tyvek_foil_surface">
			<volumeref ref="my_tyvek_sphere_log"/>
		</skinsurface>
		<skinsurface name="inner_sphere_surface" surfaceproperty="tyvek_foil_surface">
			<volumeref ref="inner_sphere_log"/>
		</skinsurface>
	</structure>
	<userinfo>
		<auxiliary auxtype="RMG_detector_meta" auxvalue=""/>
		<auxiliary auxtype="RMG_detector" auxvalue="optical">
			<auxiliary auxtype="TyvekSphere_phys" auxvalue="1000"/>
			<auxiliary auxtype="InnerSphere_phys" auxvalue="9000"/>
		</auxiliary>
	</userinfo>
	<setup name="Default" version="1.0">
