	<structure>
		<volume name="tykev_prisma">
			<materialref ref="tyvek"/>
			<solidref ref="final"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,1,1,0.2"/>
		</volume>
		<volume name="tyvek_bottom">
			<materialref ref="tyvek"/>
			<solidref ref="tykev_foild_bottom"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,1,1,0.2"/>
		</volume>
		<volume name="skirt">
			<materialref ref="metal_steel"/>
			<solidref ref="skirt_sol"/>
		</volume>
		<volume name="foot">
			<materialref ref="metal_steel"/>
			<solidref ref="foot_sol"/>
		</volume>
		<volume name="undergroundlar">
			<materialref ref="LiquidArgon"/>
			<solidref ref="uglar_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.1,0.8,0.3,0.1"/>
		</volume>
		<volume name="reentrancetube">
			<materialref ref="metal_copper"/>
			<solidref ref="tube_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.8,0.7,0.1,0.2"/>
			<physvol name="undergroundlar">
				<volumeref ref="undergroundlar"/>
			</physvol>
		</volume>
		<volume name="atmosphericlar">
			<materialref ref="LiquidArgon"/>
			<solidref ref="atmlar_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.1,0.8,0.3,0.1"/>
			<physvol name="reentrancetube">
				<volumeref ref="reentrancetube"/>
			</physvol>
		</volume>
		<volume name="innercryostat">
			<materialref ref="LiquidArgon"/>
			<solidref ref="icryo_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.5,0.5,0.5,0.25"/>
			<physvol name="atmosphericlar">
				<volumeref ref="atmosphericlar"/>
			</physvol>
		</volume>
		<volume name="vacuumgap">
			<materialref ref="vacuum"/>
			<solidref ref="vac_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.6,0.0,0.6,0.1"/>
			<physvol name="innercryostat">
				<volumeref ref="innercryostat"/>
			</physvol>
		</volume>
		<volume name="outercryostat">
			<materialref ref="metal_steel"/>
			<solidref ref="ocryo_sol"/>
			<auxiliary auxtype="rmg_color" auxvalue="0.5,0.5,0.5,0.25"/>
			<physvol name="vacuumgap">
				<volumeref ref="vacuumgap"/>
			</physvol>
		</volume>
		<volume name="tank_water">
			<materialref ref="Water"/>
			<solidref ref="water_base"/>
			<auxiliary auxtype="rmg_color" auxvalue="0,0,1,0.2"/>
			<physvol name="tyvek_prism_foil">
				<volumeref ref="tykev_prisma"/>
			</physvol>
			<physvol name="tyvek__bottom_foil">
				<volumeref ref="tyvek_bottom"/>
				<position name="tyvek__bottom_foil_pos" x="0.000000000000000" y="0.000000000000000" z="70.000000000000000" unit="mm"/>
			</physvol>
			<physvol name="skirt">
				<volumeref ref="skirt"/>
				<position name="skirt_pos" x="0.000000000000000" y="0.000000000000000" z="1057.875000000000000" unit="mm"/>
			</physvol>
			<physvol name="foot">
				<volumeref ref="foot"/>
				<position name="foot_pos" x="0.000000000000000" y="0.000000000000000" z="95.000000000000000" unit="mm"/>
			</physvol>
			<physvol name="outercryostat">
				<volumeref ref="outercryostat"/>
				<position name="outercryostat_pos" x="0.000000000000000" y="0.000000000000000" z="5000.000000000000000" unit="mm"/>
			</physvol>
		</volume>
		<volume name="tank">
			<materialref ref="metal_steel"/>
			<solidref ref="tank_base"/>
			<auxiliary auxtype="rmg_color" auxvalue="-1"/>
			<physvol name="water">
				<volumeref ref="tank_water"/>
			</physvol>
		</volume>
		<volume name="world">
			<materialref ref="G4_Galactic"/>
			<solidref ref="world"/>
			<physvol name="tank">
				<volumeref ref="tank"/>
				<position name="tank_pos" x="0.000000000000000" y="0.000000000000000" z="-5000.000000000000000" unit="mm"/>
			</physvol>
		</volume>
		<skinsurface name="tank_steel_surface" surfaceproperty="pmt_steel_surface">
			<volumeref ref="tank"/>
		</skinsurface>
		<skinsurface name="tyvek_prism_surface" surfaceproperty="tyvek_foil_surface">
			<volumeref ref="tykev_prisma"/>
		</skinsurface>
		<skinsurface name="tyvek_bottom_surface" surfaceproperty="tyvek_foil_surface">
			<volumeref ref="tyvek_bottom"/>
		</skinsurface>
	</structure>
	<userinfo>
