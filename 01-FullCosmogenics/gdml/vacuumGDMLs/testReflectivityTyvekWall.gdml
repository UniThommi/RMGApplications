<?xml version="1.0" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
	<define>
		<matrix name="vacuum_RINDEX" coldim="2" values="1.0*eV 1.0 6.0*eV 1.0"/>
		<matrix name="my_tyvek_foil_surface_EFFICIENCY" coldim="2" values="1*eV 1.0 6*eV 1.0"/>
		<matrix name="my_tyvek_foil_surface_REFLECTIVITY" coldim="2" values="1.5498024804150035*eV 0.913 2.4796839686640055*eV 0.913 2.8178226916636424*eV 0.913 3.099604960830007*eV 0.913 3.4925126319211346*eV 0.899 4.1328066144400095*eV 0.856 4.959367937328011*eV 0.761"/>
	</define>
	<materials>
		<element name="Hydrogen" formula="H" Z="1">
			<atom value="1.00794"/>
		</element>
		<material name="vacuum">
			<property name="RINDEX" ref="vacuum_RINDEX"/>
			<D value="1e-25"/>
			<composite ref="Hydrogen" n="1"/>
		</material>
		<element name="Carbon" formula="C" Z="6">
			<atom value="12.011"/>
		</element>
		<material name="my_tyvek">
			<D value="0.38"/>
			<composite ref="Carbon" n="2"/>
			<composite ref="Hydrogen" n="4"/>
		</material>
	</materials>
	<solids>
		<box name="world" x="6" y="6" z="6" lunit="m"/>
		<box name="wall_solid" x="1950.0" y="1950.0" z="1.0" lunit="mm"/>
		<opticalsurface name="my_tyvek_foil_surface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="0.3">
			<property name="EFFICIENCY" ref="my_tyvek_foil_surface_EFFICIENCY"/>
			<property name="REFLECTIVITY" ref="my_tyvek_foil_surface_REFLECTIVITY"/>
		</opticalsurface>
	</solids>
	<structure>
		<volume name="wall_log">
			<materialref ref="my_tyvek"/>
			<solidref ref="wall_solid"/>
			<auxiliary auxtype="rmg_color" auxvalue="1,1,1,0.2"/>
		</volume>
		<volume name="world">
			<materialref ref="vacuum"/>
			<solidref ref="world"/>
			<physvol name="Wall_phys">
				<volumeref ref="wall_log"/>
			</physvol>
		</volume>
		<skinsurface name="wall_surface" surfaceproperty="my_tyvek_foil_surface">
			<volumeref ref="wall_log"/>
		</skinsurface>
	</structure>
	<userinfo>
		<auxiliary auxtype="RMG_detector_meta" auxvalue=""/>
		<auxiliary auxtype="RMG_detector" auxvalue="optical">
			<auxiliary auxtype="Wall_phys" auxvalue="1000"/>
		</auxiliary>
	</userinfo>
	<setup name="Default" version="1.0">
		<world ref="world"/>
	</setup>
</gdml>
