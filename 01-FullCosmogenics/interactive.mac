# Interactive OpenGL visualisation of optical photons (3.095 eV, about 400 nm) shot from
# a square plane onto the wall test geometry; registers Wall_phys as optical detector 1000.
/RMG/Processes/HadronicPhysics Shielding
/RMG/Processes/Realm CosmicRays
/RMG/Processes/OpticalPhysics true
/RMG/Geometry/RegisterDetector Optical Wall_phys 1000

#/RMG/Geometry/RegisterDetector Optical PMT0202 10202
#/RMG/Geometry/RegisterDetector Optical PMT0208 10208
#/RMG/Geometry/RegisterDetector Optical PMT0505 10505
#/RMG/Geometry/RegisterDetector Optical PMT0802 10802
#/RMG/Geometry/RegisterDetector Optical PMT0808 10808

/run/initialize

/vis/open OGL

/vis/scene/create
/vis/sceneHandler/attach

/vis/drawVolume

/vis/scene/add/trajectories smooth
/vis/scene/add/hits
/vis/scene/endOfEventAction accumulate

/process/optical/boundary/verbose 2

/RMG/Generator/Select GPS
/gps/particle opticalphoton
/gps/energy 3.095 eV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/centre 0 0 -1000 mm   # Position: centre of the square at z = -1000 mm, in front of the wall
/gps/pos/halfx 975 mm          # Half-length in x: half of the 1950 mm
/gps/pos/halfy 975 mm          # Half-length in y: half of the 1950 mm
/gps/direction 0 0 1           # Direction: +z, i.e. straight onto the wall

/run/beamOn 100