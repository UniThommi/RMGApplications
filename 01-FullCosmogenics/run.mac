/RMG/Manager/Logging/LogLevel summary

#/tracking/verbose 2

/RMG/Processes/HadronicPhysics Shielding
/RMG/Processes/Realm CosmicRays
# MUSUN simulation (sim1): NC truth only, without optical photons.
# The homogeneous-NC simulation uses true (NC truth and optical photons in one file).
/RMG/Processes/OpticalPhysics false
# These output schemes are only registered with the -s option (see main.cc).
/RMG/Output/ActivateOutputScheme MyNeutronCaptureOutputScheme
/RMG/Output/ActivateOutputScheme MyGammaCaptureOutputScheme
#/RMG/Output/ActivateOutputScheme IsotopeFilter

# Capture gammas from the cascade files set after /run/initialize (remage process RMGnCapture)
/RMG/Processes/UseGrabmayrsGammaCascades true

/control/execute ./gdml/macroZylSSD.mac  # Initialises the detectors from the macro file created with legend-pygeom-l1000

/run/initialize

# Cascade file per capturing isotope (Z, A). The 156Gd and 158Gd files are not
# included in the repository.
/RMG/GrabmayrGammaCascades/SetGammaCascadeRandomStartLocation 1
/RMG/GrabmayrGammaCascades/SetGammaCascadeFile 64 155 ./GrabmayrGammaCascades/156Gd-5keV-cascades.txt
/RMG/GrabmayrGammaCascades/SetGammaCascadeFile 64 157 ./GrabmayrGammaCascades/158Gd-5keV-cascades.txt
/RMG/GrabmayrGammaCascades/SetGammaCascadeFile 1 1 ./GrabmayrGammaCascades/2H-5keV-cascades.txt

#/process/inactivate Scintillation      # Not all scintillation yields for L1000 are defined in remage. This can cause the run to abort.
#/process/optical/boundary/verbose 2

#/RMG/Output/IsotopeFilter/AddIsotope 77 32 # Ge77 filter
#/RMG/Output/IsotopeFilter/DiscardPhotonsIfIsotopeNotProduced true
/RMG/Output/NtuplePerDetector false

#/RMG/Generator/Confine Volume   ### Select all relevant volumes of tank_water
#/RMG/Generator/Confinement/Physical/AddVolume water
#/RMG/Generator/Confinement/Physical/AddVolume skirt
#/RMG/Generator/Confinement/Physical/AddVolume foot
#/RMG/Generator/Confinement/Physical/AddVolume outercryostat
#/RMG/Generator/Select GPS
#/RMG/Generator/Confinement/MaxSamplingTrials 10000
#/gps/particle neutron
#/gps/energy 10000 eV


# Homogeneous-NC simulation: neutrons distributed homogeneously in a cylinder
# (replaces the MUSUN generator below).
#/RMG/Generator/Select GPS
#/RMG/Generator/Confine Volume
#/RMG/Generator/Confinement/SamplingMode UnionAll
#/RMG/Generator/Confinement/Geometrical/AddSolid Cylinder
#/RMG/Generator/Confinement/Geometrical/CenterPositionX 0 mm
#/RMG/Generator/Confinement/Geometrical/CenterPositionY 0 mm
#/RMG/Generator/Confinement/Geometrical/CenterPositionZ -540 mm
#/RMG/Generator/Confinement/Geometrical/Cylinder/InnerRadius 0 mm
#/RMG/Generator/Confinement/Geometrical/Cylinder/OuterRadius 4500 mm
#/RMG/Generator/Confinement/Geometrical/Cylinder/Height 8920 mm
#/RMG/Generator/Confinement/Geometrical/Cylinder/StartingAngle 0 deg
#/RMG/Generator/Confinement/Geometrical/Cylinder/SpanningAngle 360 deg
#/RMG/Generator/Confinement/MaxSamplingTrials 10000
#/gps/particle neutron
#/gps/energy 10000 eV # Highest energy without transport before the NC
#/gps/ang/type iso


# MUSUN simulation (sim1): cosmic muons from the MUSUN file (not included in the repository)
/RMG/Generator/Confine UnConfined
/RMG/Generator/Select MUSUNCosmicMuons
/RMG/Generator/MUSUNCosmicMuons/SetMUSUNFile musun/combined_file.dat


# 120min
#/run/beamOn 1000000

/run/beamOn 10000